# --- dyski (sciezki montowania) - dane NIE moga trafic na karte SD ---
# dysk na configi i bazy uslug (u mnie /mnt/Data1T)
DATA1T_DIR=
# katalog data-root Dockera z /etc/docker/daemon.json (u mnie /mnt/Dane4T/docker)
DOCKER_DATA_ROOT=

# musi byc taka sama wartosc jak PIHOLE_WEBPASSWORD w Docker/pi-hole/.env -
# ten kontener loguje sie do API pi-hole tym haslem
PIHOLE_WEBPASSWORD=

# adres IP hosta z pi-hole (RPi)
PIHOLE_HOSTNAME=
