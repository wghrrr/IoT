# --- dyski (sciezki montowania) - dane NIE moga trafic na karte SD ---
# dysk na configi i bazy uslug (u mnie /mnt/Data1T)
DATA1T_DIR=

# tryb signal-cli-rest-api: normal (rejestracja numeru), potem json-rpc-native
SIGNAL_MODE=normal

# port API na 127.0.0.1 hosta (domyslnie 8095); ten sam adres w konfiguracji HA
SIGNAL_PORT=8095
